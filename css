:root {
  --utama: #16a34a;
  --gelap: #14532d;
  --latar: #f3f4f6;
  --teks: #1f2937;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: system-ui, sans-serif;
  background: var(--latar);
  color: var(--teks);
  padding-bottom: 70px;
}

.topbar {
  background: var(--utama);
  color: #fff;
  padding: 12px 14px;
  position: sticky;
  top: 0;
  z-index: 10;
}
.topbar h1 { font-size: 20px; margin-bottom: 8px; }
.topbar input {
  width: 100%;
  padding: 10px 14px;
  border: none;
  border-radius: 20px;
  font-size: 15px;
}

main { padding: 12px; }

.kategori {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 10px;
}
.chip {
  background: #fff;
  border: 1px solid var(--utama);
  color: var(--gelap);
  padding: 6px 14px;
  border-radius: 16px;
  white-space: nowrap;
  font-size: 14px;
}
.chip.aktif { background: var(--utama); color: #fff; }

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
.kartu {
  background: #fff;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.1);
}
.foto {
  height: 110px;
  background: #d1fae5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40px;
}
.info { padding: 8px 10px 10px; }
.info h3 { font-size: 14px; font-weight: 600; }
.harga { color: var(--utama); font-weight: 700; margin: 4px 0; }
.info button {
  width: 100%;
  background: var(--utama);
  color: #fff;
  border: none;
  padding: 8px;
  border-radius: 6px;
  font-size: 13px;
}

.bawah {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  border-top: 1px solid #e5e7eb;
}
.bawah a {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: 13px;
  color: #6b7280;
  text-decoration: none;
}
.bawah a.aktif { color: var(--utama); font-weight: 700; }
